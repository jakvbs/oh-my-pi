{
  "type": "module",
  "name": "@oh-my-pi/collab-web",
  "version": "16.3.6",
  "private": true,
  "description": "Shared React tool renderers bundled into coding-agent HTML session exports",
  "homepage": "https://omp.sh",
  "author": { "name": "Stencil Labs, Inc.", "url": "https://stencil.so" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/collab-web"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "collab",
    "relay",
    "websocket",
    "react",
    "agent"
  ],
  "scripts": {
    "gen:tool-views": "bun scripts/build-tool-views.ts",
    "test": "bun test --parallel",
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,scripts}/**/*.ts' '*.ts'"
  },
  "dependencies": {
    "@oh-my-pi/pi-wire": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "scripts",
    "README.md",
    "CHANGELOG.md"
  ]
}
