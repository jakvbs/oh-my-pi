// `/login` roster order. Every provider whose auth node declares a `login`
// (and does not set `show-in-login-list #false`) must appear here; providers
// without a login flow sort alphabetically after this list.
login-order "openai-codex" "anthropic" "zai" "zai-coding-plan" "kimi-code" "openrouter" "github-copilot" \
	"openai-codex-device" "xai" "xai-oauth" \
	"aiand" "abliteration" "umans" "sakana" "sambanova" \
	"firepass" "commandcode" "charm-hyper" "deepseek" "stepfun" "muse-code" "meta" "moonshot" \
	"cerebras" "baseten" "helmcode" "fireworks" "together" "nvidia" "novita" "deepinfra" "huggingface" "perplexity" \
	"qianfan" "venice" "siliconflow" "siliconflow-cn" "synthetic" "nanogpt" "wafer-serverless" \
	"vercel-ai-gateway" "cloudflare-ai-gateway" "cloudflare-workers-ai" "litellm" "zenmux" "opencode-zen" "opencode-go" \
	"yolo-auto" "tavily" "kagi" "exa" "parallel" "typesafe" "ollama" "ollama-cloud" "lm-studio" "llama.cpp" "vllm" \
	"gmi-cloud" "stencil" "singularityapi-dev" "singularityapi-tech" "coralbricks"
