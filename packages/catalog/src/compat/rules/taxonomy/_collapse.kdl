		default-member "cursor-grok-4.6-medium-fast"
		aliases "grok-4.6-fast"
	}
	variant-family "cursor" "cursor-grok-{rev}" name="Grok {rev}" revision=">=4.7" {
		members "cursor-grok-{rev}-low" "cursor-grok-{rev}-medium" "cursor-grok-{rev}-high" "cursor-grok-{rev}-xhigh"
		route "low" "cursor-grok-{rev}-low"
