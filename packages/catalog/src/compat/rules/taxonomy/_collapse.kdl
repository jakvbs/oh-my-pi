		route "xhigh" "grok-{rev}-xhigh-fast"
		mode "effort"
		efforts "low" "medium" "high" "xhigh"
		requires-effort #true
		default-member "grok-{rev}-medium-fast"
	}
	variant-family "cursor" "gpt-5.6-luna" name="GPT-5.6 Luna" {
		members "gpt-5.6-luna-none" "gpt-5.6-luna-low" "gpt-5.6-luna-medium" "gpt-5.6-luna-high" "gpt-5.6-luna-xhigh" "gpt-5.6-luna-max"
		route "off" "gpt-5.6-luna-none"
