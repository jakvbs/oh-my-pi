	variant-family "cursor" "gpt-5.6-terra-fast" name="GPT-5.6 Terra Fast" {
		members "gpt-5.6-terra-none-fast" "gpt-5.6-terra-low-fast" "gpt-5.6-terra-medium-fast" "gpt-5.6-terra-high-fast" "gpt-5.6-terra-xhigh-fast" "gpt-5.6-terra-max-fast"
		route "off" "gpt-5.6-terra-none-fast"
		route "low" "gpt-5.6-terra-low-fast"
		route "medium" "gpt-5.6-terra-medium-fast"
		route "high" "gpt-5.6-terra-high-fast"
		route "xhigh" "gpt-5.6-terra-xhigh-fast"
		route "max" "gpt-5.6-terra-max-fast"
		mode "effort"
		efforts "low" "medium" "high" "xhigh" "max"
	}
}
