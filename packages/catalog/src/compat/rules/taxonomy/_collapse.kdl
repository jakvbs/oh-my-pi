	variant-family "cursor" "gpt-5.6-terra" name="GPT-5.6 Terra" {
		members "gpt-5.6-terra-none" "gpt-5.6-terra-low" "gpt-5.6-terra-medium" "gpt-5.6-terra-high" "gpt-5.6-terra-xhigh" "gpt-5.6-terra-max"
		route "off" "gpt-5.6-terra-none"
