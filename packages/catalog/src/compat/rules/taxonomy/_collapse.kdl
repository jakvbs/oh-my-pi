collapse {
	thinking-suffix "-thinking"
	// Thinking-pair tokens: bounded (possibly infix) markers that name the
	// thinking sibling of a live bare twin (`sonar-reasoning-pro` beside
	// `sonar-pro`). Consumed only by thinking-pair derivation - never by
	// identity suffix collapse, which stays on `thinking-suffix`.
	pair-token "thinking" "reasoning" "reasoner"
	effort-suffix "-extra-high" tier="xhigh"
	effort-suffix "-none" tier="off"
	effort-suffix "-minimal" tier="minimal"
	effort-suffix "-medium" tier="medium"
	effort-suffix "-xhigh" tier="xhigh"
	effort-suffix "-high" tier="high"
	effort-suffix "-low" tier="low"
	effort-suffix "-max" tier="max" except-bare-prefix="qwen"
	// Codex backend discovery advertises worker-mode routing variants under a
	// `-wm` suffix (`gpt-5.6-luna-wm`): the same model behind a different route,
	// with base-model metadata owned by the plain bundled SKU.
	routing-variant-suffix "-wm" "openai-codex" "openai-codex-device"
	// Cursor discovery serves pure effort-suffixed siblings as one logical
	// model. The reviewed GPT-5.6 seeds enable the generic grouping rule for
	// the provider; live metadata and duplicate-tier checks decide every
	// candidate family, including later model generations.
	effort-family "cursor" "gpt-5.6-luna"
	effort-family "cursor" "gpt-5.6-sol"
	effort-family "cursor" "gpt-5.6-terra"
	// `-fast` is a parallel SKU lane. It stays in the logical identifier while
	// the effort token immediately before it selects the wire sibling.
	effort-lane-suffix "-fast" "cursor"

	// Reviewed per-provider variant families: logical models served as
	// per-effort/thinking sibling wire ids, with explicit routing, ladders,
	// budgets, and wire facts. Ported verbatim from the legacy hand tables.
	//
	// Cloud Code Assist serves every Gemini Flash generation from 3.6 on as
	// `-low`/`-medium`/`-high` thinking-level SKUs plus a `-tiered` alias. One
	// template per provider covers each revision discovery advertises; the
	// minimal tier is served by the `-low` SKU (Gemini 3.7+ rejects MINIMAL).
	variant-family "google-antigravity" "gemini-{rev}-flash" name="Gemini {rev} Flash" revision=">=3.6" {
		members "gemini-{rev}-flash-low" "gemini-{rev}-flash-medium" "gemini-{rev}-flash-high" "gemini-{rev}-flash-tiered"
		route "minimal" "gemini-{rev}-flash-low"
		route "low" "gemini-{rev}-flash-low"
		route "medium" "gemini-{rev}-flash-medium"
		route "high" "gemini-{rev}-flash-high"
		mode "google-level"
		efforts "minimal" "low" "medium" "high"
		requires-effort #true
	}
	variant-family "google-antigravity" "gemini-3.5-flash" name="Gemini 3.5 Flash" {
		members "gemini-3.5-flash-extra-low" "gemini-3.5-flash-low" "gemini-3-flash-agent"
		route "off" "gemini-3.5-flash-extra-low"
		route "minimal" "gemini-3.5-flash-extra-low"
		route "low" "gemini-3.5-flash-extra-low"
		route "medium" "gemini-3.5-flash-low"
		route "high" "gemini-3-flash-agent"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		budget "minimal" "1000"
		budget "low" "1000"
		budget "medium" "4000"
		budget "high" "10000"
		aliases "gemini-3-flash"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gemini-3.1-pro" name="Gemini 3.1 Pro" {
		members "gemini-3.1-pro-low" "gemini-pro-agent" "gemini-3.1-pro-high"
		route "off" "gemini-3.1-pro-low"
		route "low" "gemini-3.1-pro-low"
		route "high" "gemini-pro-agent"
		mode "budget"
		efforts "low" "high"
		budget "low" "1001"
		budget "high" "10001"
		retired "gemini-3.1-pro-high"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gemini-3-pro" name="Gemini 3 Pro" {
		members "gemini-3-pro-low" "gemini-3-pro-high"
		route "off" "gemini-3-pro-low"
		route "low" "gemini-3-pro-low"
		route "high" "gemini-3-pro-high"
		mode "google-level"
		efforts "low" "high"
		suppress-when-off #true
	}
	variant-family "google-antigravity" "gpt-oss-120b" name="GPT-OSS 120B" {
		members "gpt-oss-120b-medium"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
	}
	variant-family "google-antigravity" "claude-opus-5-5" name="Claude Opus 5.5" {
		members "claude-opus-5-5-low" "claude-opus-5-5-medium" "claude-opus-5-5-high"
		route "low" "claude-opus-5-5-low"
		route "medium" "claude-opus-5-5-medium"
		route "high" "claude-opus-5-5-high"
		mode "budget"
		efforts "low" "medium" "high"
		requires-effort #true
	}
	variant-family "google-antigravity" "claude-sonnet-5-5" name="Claude Sonnet 5.5" {
		members "claude-sonnet-5-5-low" "claude-sonnet-5-5-medium" "claude-sonnet-5-5-high"
		route "low" "claude-sonnet-5-5-low"
		route "medium" "claude-sonnet-5-5-medium"
		route "high" "claude-sonnet-5-5-high"
		mode "budget"
		efforts "low" "medium" "high"
		requires-effort #true
	}
	variant-family "google-antigravity" "claude-sonnet-4-6" name="Claude Sonnet 4.6" {
		members "claude-sonnet-4-6" "claude-sonnet-4-6-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		retired "claude-sonnet-4-6-thinking"
	}
	variant-family "google-antigravity" "claude-opus-4-6" name="Claude Opus 4.6" {
		members "claude-opus-4-6-thinking" "claude-opus-4-6"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		retired "claude-opus-4-6"
	}
	variant-family "google-antigravity" "claude-sonnet-4-5" name="Claude Sonnet 4.5" {
		members "claude-sonnet-4-5" "claude-sonnet-4-5-thinking"
		route "off" "claude-sonnet-4-5"
		route "minimal" "claude-sonnet-4-5-thinking"
		route "low" "claude-sonnet-4-5-thinking"
		route "medium" "claude-sonnet-4-5-thinking"
		route "high" "claude-sonnet-4-5-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	variant-family "google-antigravity" "claude-opus-4-5" name="Claude Opus 4.5" {
		members "claude-opus-4-5" "claude-opus-4-5-thinking"
		route "off" "claude-opus-4-5"
		route "minimal" "claude-opus-4-5-thinking"
		route "low" "claude-opus-4-5-thinking"
		route "medium" "claude-opus-4-5-thinking"
		route "high" "claude-opus-4-5-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	variant-family "google-antigravity" "gemini-2.5-flash" name="Gemini 2.5 Flash" {
		members "gemini-2.5-flash" "gemini-2.5-flash-thinking"
		route "off" "gemini-2.5-flash"
		route "minimal" "gemini-2.5-flash-thinking"
		route "low" "gemini-2.5-flash-thinking"
		route "medium" "gemini-2.5-flash-thinking"
		route "high" "gemini-2.5-flash-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	variant-family "google-gemini-cli" "gemini-{rev}-flash" name="Gemini {rev} Flash" revision=">=3.6" {
		members "gemini-{rev}-flash-low" "gemini-{rev}-flash-medium" "gemini-{rev}-flash-high" "gemini-{rev}-flash-tiered"
		route "minimal" "gemini-{rev}-flash-low"
		route "low" "gemini-{rev}-flash-low"
		route "medium" "gemini-{rev}-flash-medium"
		route "high" "gemini-{rev}-flash-high"
		mode "google-level"
		efforts "minimal" "low" "medium" "high"
		requires-effort #true
	}
	variant-family "google-gemini-cli" "gemini-3.5-flash" name="Gemini 3.5 Flash" {
		members "gemini-3.5-flash-extra-low" "gemini-3.5-flash-low" "gemini-3-flash-agent"
		route "off" "gemini-3.5-flash-extra-low"
		route "minimal" "gemini-3-flash-agent"
		route "low" "gemini-3.5-flash-extra-low"
		route "medium" "gemini-3.5-flash-extra-low"
		route "high" "gemini-3.5-flash-low"
		mode "google-level"
		efforts "minimal" "low" "medium" "high"
		aliases "gemini-3-flash"
		suppress-when-off #true
	}
	variant-family "google-gemini-cli" "gemini-3.1-pro" name="Gemini 3.1 Pro" {
		members "gemini-3.1-pro-low" "gemini-pro-agent" "gemini-3.1-pro-high"
		route "off" "gemini-3.1-pro-low"
		route "low" "gemini-3.1-pro-low"
		route "high" "gemini-pro-agent"
		mode "google-level"
		efforts "low" "high"
		retired "gemini-3.1-pro-high"
		suppress-when-off #true
	}
	variant-family "google-gemini-cli" "gemini-3-pro" name="Gemini 3 Pro" {
		members "gemini-3-pro-low" "gemini-3-pro-high"
		route "off" "gemini-3-pro-low"
		route "low" "gemini-3-pro-low"
		route "high" "gemini-3-pro-high"
		mode "google-level"
		efforts "low" "high"
		suppress-when-off #true
	}
	variant-family "google-gemini-cli" "gpt-oss-120b" name="GPT-OSS 120B" {
		members "gpt-oss-120b-medium"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
	}
	variant-family "google-gemini-cli" "claude-sonnet-4-6" name="Claude Sonnet 4.6" {
		members "claude-sonnet-4-6" "claude-sonnet-4-6-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		retired "claude-sonnet-4-6-thinking"
	}
	variant-family "google-gemini-cli" "claude-opus-4-6" name="Claude Opus 4.6" {
		members "claude-opus-4-6-thinking" "claude-opus-4-6"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		retired "claude-opus-4-6"
	}
	variant-family "google-gemini-cli" "claude-sonnet-4-5" name="Claude Sonnet 4.5" {
		members "claude-sonnet-4-5" "claude-sonnet-4-5-thinking"
		route "off" "claude-sonnet-4-5"
		route "minimal" "claude-sonnet-4-5-thinking"
		route "low" "claude-sonnet-4-5-thinking"
		route "medium" "claude-sonnet-4-5-thinking"
		route "high" "claude-sonnet-4-5-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	variant-family "google-gemini-cli" "claude-opus-4-5" name="Claude Opus 4.5" {
		members "claude-opus-4-5" "claude-opus-4-5-thinking"
		route "off" "claude-opus-4-5"
		route "minimal" "claude-opus-4-5-thinking"
		route "low" "claude-opus-4-5-thinking"
		route "medium" "claude-opus-4-5-thinking"
		route "high" "claude-opus-4-5-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	variant-family "google-gemini-cli" "gemini-2.5-flash" name="Gemini 2.5 Flash" {
		members "gemini-2.5-flash" "gemini-2.5-flash-thinking"
		route "off" "gemini-2.5-flash"
		route "minimal" "gemini-2.5-flash-thinking"
		route "low" "gemini-2.5-flash-thinking"
		route "medium" "gemini-2.5-flash-thinking"
		route "high" "gemini-2.5-flash-thinking"
		mode "budget"
		efforts "minimal" "low" "medium" "high"
		preserve-absent-effort-routes #true
	}
	// Retired id: the Codex image model was relabeled to what the backend runs
	// (gpt-image-2-codex); keep saved `openai-codex/gpt-image-1` roles resolving.
	provider-alias "openai-codex" "gpt-image-1" "gpt-image-2"
	// Retired rich-lane ids: AvailableModels discovery named Grok 4.5/4.6 lanes
	// after the unprefixed model name before they adopted these family ids
	// (#14164). Family `aliases` (not `provider-alias`) so saved selectors and
	// models.yml `modelOverrides` keyed by the old ids both migrate. Grok 4.6
	// is spelled out instead of riding the `cursor-grok-{rev}` template: a
	// templated `grok-{rev}` alias would also claim the live Grok 4.7+ ids.
	variant-family "cursor" "cursor-grok-4.5" name="Grok 4.5" {
		members "cursor-grok-4.5-low" "cursor-grok-4.5-medium" "cursor-grok-4.5-high"
		route "low" "cursor-grok-4.5-low"
		route "medium" "cursor-grok-4.5-medium"
		route "high" "cursor-grok-4.5-high"
		mode "effort"
		efforts "low" "medium" "high"
		requires-effort #true
		default-member "cursor-grok-4.5-medium"
		aliases "grok-4.5"
	}
	variant-family "cursor" "cursor-grok-4.5-fast" name="Grok 4.5 Fast" {
		members "cursor-grok-4.5-low-fast" "cursor-grok-4.5-medium-fast" "cursor-grok-4.5-high-fast"
		route "low" "cursor-grok-4.5-low-fast"
		route "medium" "cursor-grok-4.5-medium-fast"
		route "high" "cursor-grok-4.5-high-fast"
		mode "effort"
		efforts "low" "medium" "high"
		requires-effort #true
		default-member "cursor-grok-4.5-medium-fast"
		aliases "grok-4.5-fast"
	}
	variant-family "cursor" "cursor-grok-4.6" name="Grok 4.6" {
		members "cursor-grok-4.6-low" "cursor-grok-4.6-medium" "cursor-grok-4.6-high" "cursor-grok-4.6-xhigh"
		route "low" "cursor-grok-4.6-low"
		route "medium" "cursor-grok-4.6-medium"
		route "high" "cursor-grok-4.6-high"
		route "xhigh" "cursor-grok-4.6-xhigh"
		mode "effort"
		efforts "low" "medium" "high" "xhigh"
		requires-effort #true
		default-member "cursor-grok-4.6-medium"
		aliases "grok-4.6"
	}
	variant-family "cursor" "cursor-grok-4.6-fast" name="Grok 4.6 Fast" {
		members "cursor-grok-4.6-low-fast" "cursor-grok-4.6-medium-fast" "cursor-grok-4.6-high-fast" "cursor-grok-4.6-xhigh-fast"
		route "low" "cursor-grok-4.6-low-fast"
		route "medium" "cursor-grok-4.6-medium-fast"
		route "high" "cursor-grok-4.6-high-fast"
		route "xhigh" "cursor-grok-4.6-xhigh-fast"
